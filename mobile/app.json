{
  "expo": {
    "name": "KeskonBouf",
    "slug": "keskonbouf",
    "scheme": "keskonbouf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keskonbouf.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pour ajouter la photo de tes recettes.",
        "NSCameraUsageDescription": "Pour photographier tes plats."
      }
    },
    "android": {
      "package": "com.keskonbouf.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF7EE"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#294E3B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour ajouter la photo de tes recettes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
